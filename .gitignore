# preview/*.svg is committed: tools/scene.py generates it and the README shows it as animation
__pycache__/

# before/after comparisons and animations, only for viewing
preview/*.png
preview/*.gif

# the programs, only for viewing (tools/scene.py writes them; scene.ts has them all)
preview/program-*.svg
preview/ball-program-*.svg
preview/programs.html

# sleeping without lying down, what a reopened conversation shows (scene.ts has it)
preview/*asleep.svg

# the props compared with their drawings, only for viewing (tools/props.py writes them)
preview/props.html
preview/props-src/
preview/props-every.svg
preview/variants/
preview/far-variants.html

# tokens (tools/pixellab.py reads its own; never committed)
secrets/

# PixelLab candidates, only for viewing (tools/pixellab.py writes them)
preview/pixellab/
preview/pixellab.html
